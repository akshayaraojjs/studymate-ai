# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=replace_with_a_secure_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# With docker compose (Postgres + pgvector):
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/studymate
# Without Docker the app falls back to a local SQLite file when DATABASE_URL is
# unset: sqlite:///./data/studymate.db (vector search runs in Python).

# ---------------------------------------------------------------------------
# LLM provider (Groq)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# gpt-oss models: low | medium | high (low reduces time to first token)
LLM_REASONING_EFFORT=low

# Embeddings. Groq does not serve an embeddings endpoint, so embeddings come
# from a local model (fastembed) when installed, otherwise from a deterministic
# lexical hashing embedder (lower quality, zero download).
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Web search (optional)
# ---------------------------------------------------------------------------
# Default backend is DuckDuckGo HTML search (no key required).
# Set WEB_SEARCH_PROVIDER=tavily and a key for a keyed provider.
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# RAG / ingestion limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
MAX_TOOL_CALLS=4
